# Copy this file to .env and adjust as needed: `cp .env.example .env`
# The MVP needs no secrets. CVM and BCB open data require no authentication.
#
# Every value below is also the built-in default in src/fee_drag/config.py, so an empty
# .env behaves exactly like this file. The process environment always wins over .env,
# which is what lets CI and Docker override anything without editing a file.

# --- Local paths (relative paths are anchored to FEE_DRAG_PROJECT_ROOT) ---
FEE_DRAG_PROJECT_ROOT=.
FEE_DRAG_DATA_DIR=data
FEE_DRAG_RAW_DIR=data/raw
FEE_DRAG_BRONZE_DIR=data/bronze
FEE_DRAG_EXPORT_DIR=data/exports
FEE_DRAG_DUCKDB_PATH=data/warehouse.duckdb
FEE_DRAG_MANIFEST_PATH=data/bronze/_manifest.parquet

# --- Logging ---
FEE_DRAG_LOG_LEVEL=INFO

# --- Data sources (see docs/data_sources.md) ---
CVM_DAILY_REPORTS_BASE_URL=https://dados.cvm.gov.br/dados/FI/DOC/INF_DIARIO/DADOS
CVM_REGISTRY_BASE_URL=https://dados.cvm.gov.br/dados/FI/CAD/DADOS
CVM_EXTRATO_BASE_URL=https://dados.cvm.gov.br/dados/FI/DOC/EXTRATO/DADOS
BCB_SGS_BASE_URL=https://api.bcb.gov.br/dados/serie

# --- HTTP client behaviour ---
# Retries cover transport errors, timeouts, 429 and 5xx. A 404 or 403 fails immediately.
# Backoff is exponential with full jitter: base * 2**attempt, randomised.
HTTP_TIMEOUT_SECONDS=60
HTTP_MAX_RETRIES=5
HTTP_BACKOFF_BASE_SECONDS=1.0

# --- Ingestion window defaults ---
INGEST_START_MONTH=2021-01
